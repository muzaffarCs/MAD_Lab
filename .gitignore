# ==========================================

# MAD_Lab - Root Git Ignore

# ==========================================

# ---------- Environment & Secrets ----------

.env
.env.*
!.env.example

# API keys / credentials

*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json
service-account.json

# ---------- IDE / Editors ----------

.vscode/
.idea/
*.iml

# ---------- Operating System ----------

.DS_Store
Thumbs.db
Desktop.ini

# ---------- Logs ----------

*.log

# ---------- Temporary Files ----------

*.tmp
*.temp
*.swp
*.swo
*.bak

# ---------- Build / Generated Files ----------

build/
out/
dist/

# ---------- Local Configuration ----------

local.properties

# ---------- Node / JavaScript (if used in future labs) ----------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Python (if used in future labs) ----------

**pycache**/
*.py[cod]
.venv/
venv/
env/

# ---------- Archives / Large Temporary Files ----------

*.zip
*.tar
*.gz

# ---------- Personal / Local Notes ----------

notes-private/
private/
